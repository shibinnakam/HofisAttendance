# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster address with your MongoDB Atlas details
# Example: mongodb+srv://admin:password123@cluster0.abcde.mongodb.net/rfid_attendance?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rfid_attendance?retryWrites=true&w=majority
